# Virtual Environments
.venv/
venv/
env/
ENV/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.pyd
.pytest_cache/

# Credentials & environment variables
.env
.env.*
*.pem
*.key

# Ultralytics & Model Weights (Do NOT commit large weights by default)
runs/
*.pt
*.onnx
*.engine
*.tflite
models/*.pt
models/*.onnx
!models/best.pt

# Dataset archives
*.zip
*.tar
*.tar.gz

# Datasets (do NOT push dataset images and labels to Git)
dataset/train/
dataset/valid/
dataset/test/
dataset/sample_test_images/
dataset_balanced/
dataset_balanced_v2/

# Keep dataset configuration tracked
!dataset/data.yaml
!dataset/README*.txt

# Generated outputs & scratch files
outputs/
reports/baseline_smoke_test/
*.log
scratch/

# IDE & OS specific files
.vscode/*
!.vscode/BiomedicalWasteAI
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
